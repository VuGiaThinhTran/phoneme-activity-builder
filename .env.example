# Copy this file to .env and fill in real values for local (non-Docker) development.
# When running via `docker compose up`, DATABASE_URL is already set in
# docker-compose.yml and this file isn't needed.

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/phoneme_builder?schema=public"

# Optional tracing for local (non-Docker) development. Start Jaeger on its own
# (or `docker compose up jaeger`), then open http://localhost:16686.
# OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"
# OTEL_EXPORTER_OTLP_PROTOCOL="http/json"
